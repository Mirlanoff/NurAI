NURAI_ENVIRONMENT=production
NURAI_CHUNK_SIZE=700
NURAI_CHUNK_OVERLAP=100
NURAI_EMBEDDING_BACKEND=hashing
NURAI_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NURAI_EMBEDDING_DIMENSIONS=384
NURAI_DEFAULT_TOP_K=5
NURAI_RETRIEVAL_BACKEND=hybrid
NURAI_RETRIEVAL_CANDIDATE_MULTIPLIER=3
NURAI_HYBRID_VECTOR_WEIGHT=0.7
NURAI_RERANKER_BACKEND=lexical
NURAI_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
NURAI_VECTOR_STORE_BACKEND=qdrant
NURAI_QDRANT_URL=http://qdrant:6333
NURAI_QDRANT_COLLECTION=nurai_documents
NURAI_QDRANT_TIMEOUT_SECONDS=5
NURAI_MAX_UPLOAD_BYTES=2000000
NURAI_LOG_LEVEL=INFO
NURAI_API_KEY=
NURAI_RATE_LIMIT_ENABLED=true
NURAI_RATE_LIMIT_REQUESTS=120
NURAI_RATE_LIMIT_WINDOW_SECONDS=60
NURAI_METRICS_ENABLED=true
NURAI_REQUEST_ID_HEADER=X-Request-ID
